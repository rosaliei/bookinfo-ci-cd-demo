      "updated": 1,
      "link": null,
      "locked": false,
      "text": "bazel_dep(name = \"rules_python\", version = \"1.9.2\")\nbazel_dep(name = \"rules_nodejs\", version = \"6.7.6\")\nbazel_dep(name = \"aspect_rules_js\", version = \"2.8.3\")\nbazel_dep(name = \"container_structure_test\", version = \"1.22.1\")\nbazel_dep(name = \"rules_oci\", version = \"2.3.0\")\nbazel_dep(name = \"tar.bzl\", version = \"0.10.9\")\n\npython.toolchain(python_version = \"3.13\", is_default = True)\npip.parse(hub_name = \"pypi\",\n          requirements_lock = \"//productpage:requirements.txt\")\npip.parse(hub_name = \"pypi_test\",\n          requirements_lock = \"//productpage:test-requirements.txt\")\n\nnode.toolchain(node_version = \"24.20.0\")\nnpm.npm_translate_lock(name = \"npm\",\n                       pnpm_lock = \"//ratings:pnpm-lock.yaml\")\n\noci.pull(name = \"debian_slim\",\n         image = \"docker.io/library/debian\",\n         digest = \"sha256:a29215f6...\")   # trixie-slim",
      "originalText": "bazel_dep(name = \"rules_python\", version = \"1.9.2\")\nbazel_dep(name = \"rules_nodejs\", version = \"6.7.6\")\nbazel_dep(name = \"aspect_rules_js\", version = \"2.8.3\")\nbazel_dep(name = \"container_structure_test\", version = \"1.22.1\")\nbazel_dep(name = \"rules_oci\", version = \"2.3.0\")\nbazel_dep(name = \"tar.bzl\", version = \"0.10.9\")\n\npython.toolchain(python_version = \"3.13\", is_default = True)\npip.parse(hub_name = \"pypi\",\n          requirements_lock = \"//productpage:requirements.txt\")\npip.parse(hub_name = \"pypi_test\",\n          requirements_lock = \"//productpage:test-requirements.txt\")\n\nnode.toolchain(node_version = \"24.20.0\")\nnpm.npm_translate_lock(name = \"npm\",\n                       pnpm_lock = \"//ratings:pnpm-lock.yaml\")\n\noci.pull(name = \"debian_slim\",\n         image = \"docker.io/library/debian\",\n         digest = \"sha256:a29215f6...\")   # trixie-slim",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
