      "updated": 1,
      "link": null,
      "locked": false,
      "text": "  build:\n    needs: changes\n    strategy:\n      fail-fast: false\n      matrix:\n        service: ${{ fromJSON(needs.changes.outputs.services) }}\n    steps:\n      - uses: bazel-contrib/setup-bazel@...   # 0.19.0\n        with: { disk-cache: ${{ matrix.service }}, repository-cache: true }\n      - uses: actions/cache@...               # v6.1.0\n        with: { path: ~/.bazel/external, key: bazel-external-<svc>-<hash of locks> }\n      - run: bazel test //${{ matrix.service }}/...\n      - run: bazel run //${{ matrix.service }}:load\n      - uses: aquasecurity/trivy-action@...   # v0.36.0\n        with: { image-ref: bookinfo-<svc>:ci, exit-code: \"1\" }\n\n  push:\n    needs: [changes, build, sast, dependency-scan]\n    if: github.ref == 'refs/heads/main' && github.event_name == 'push'\n      - run: bazel run //${{ matrix.service }}:push -- --tag <sha> --tag latest",
      "originalText": "  build:\n    needs: changes\n    strategy:\n      fail-fast: false\n      matrix:\n        service: ${{ fromJSON(needs.changes.outputs.services) }}\n    steps:\n      - uses: bazel-contrib/setup-bazel@...   # 0.19.0\n        with: { disk-cache: ${{ matrix.service }}, repository-cache: true }\n      - uses: actions/cache@...               # v6.1.0\n        with: { path: ~/.bazel/external, key: bazel-external-<svc>-<hash of locks> }\n      - run: bazel test //${{ matrix.service }}/...\n      - run: bazel run //${{ matrix.service }}:load\n      - uses: aquasecurity/trivy-action@...   # v0.36.0\n        with: { image-ref: bookinfo-<svc>:ci, exit-code: \"1\" }\n\n  push:\n    needs: [changes, build, sast, dependency-scan]\n    if: github.ref == 'refs/heads/main' && github.event_name == 'push'\n      - run: bazel run //${{ matrix.service }}:push -- --tag <sha> --tag latest",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
