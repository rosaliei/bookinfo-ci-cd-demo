load("@container_structure_test//:defs.bzl", "container_structure_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@tar.bzl//tar:mtree.bzl", "mtree_mutate", "mtree_spec")
load("@tar.bzl//tar:tar.bzl", "tar")

py_library(
    name = "productpage_lib",
    srcs = ["productpage.py"],
    data = glob([
        "static/**",
        "templates/**",
    ]),
    imports = ["."],
    deps = [
        "@pypi//flask",
        "@pypi//json2html",
        "@pypi//opentelemetry_api",
        "@pypi//opentelemetry_instrumentation_flask",
        "@pypi//opentelemetry_propagator_b3",
        "@pypi//opentelemetry_sdk",
        "@pypi//prometheus_client",
        "@pypi//requests",
        "@pypi//simplejson",
    ],
)

py_test(
    name = "productpage_test",
    srcs = [
        "tests/unit/run_tests.py",
        "tests/unit/test_productpage.py",
    ],
    imports = ["tests/unit"],
    main = "tests/unit/run_tests.py",
    deps = [
        ":productpage_lib",
        "@pypi_test//requests_mock",
    ],
)

py_binary(
    name = "productpage_bin",
    srcs = ["serve.py"],
    main = "serve.py",
    deps = [
        ":productpage_lib",
        "@pypi//gevent",
        "@pypi//gunicorn",
    ],
)

# Image layer: the binary, its runfiles (app, dependencies, interpreter)
mtree_spec(
    name = "layer_mtree",
    srcs = [":productpage_bin"],
)

# Keep the launcher's venv/bin/python3 symlink (it points at the bundled interpreter)
mtree_mutate(
    name = "layer_mtree_links",
    srcs = [":productpage_bin"],
    mtree = ":layer_mtree",
    preserve_symlinks = True,
)

tar(
    name = "layer",
    srcs = [":productpage_bin"],
    compress = "gzip",
    mtree = ":layer_mtree_links",
)

oci_image(
    name = "image",
    base = "@debian_slim",
    entrypoint = ["/productpage/productpage_bin"],
    env = {"FLOOD_FACTOR": "0"},
    exposed_ports = ["9080/tcp"],
    tars = [":layer"],
    user = "1000",
)

# Runs the image in Docker and checks it starts as configured (see image_test.yaml)
container_structure_test(
    name = "image_test",
    configs = ["image_test.yaml"],
    image = ":image",
)

# bazel run //productpage:load  -> loads bookinfo-productpage:ci into Docker
oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["bookinfo-productpage:ci"],
)

# bazel run //productpage:push -- --tag <tag>
oci_push(
    name = "push",
    image = ":image",
    repository = "ghcr.io/rosaliei/bookinfo-productpage",
)
