"""Bazel build for the Bookinfo services: tests, OCI images and pushes."""

module(name = "bookinfo")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "aspect_rules_js", version = "2.8.3")
bazel_dep(name = "container_structure_test", version = "1.22.1")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "tar.bzl", version = "0.10.9")

# --- Python (productpage) ---------------------------------------------------
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Runtime dependencies (same hash-pinned lock the Dockerfile installs)
pip.parse(
    hub_name = "pypi",
    python_version = "3.13",
    requirements_lock = "//productpage:requirements.txt",
)

# Test-only dependencies (requests-mock)
pip.parse(
    hub_name = "pypi_test",
    python_version = "3.13",
    requirements_lock = "//productpage:test-requirements.txt",
)
use_repo(pip, "pypi", "pypi_test")

# --- Node.js (ratings) ------------------------------------------------------
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.20.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//ratings:pnpm-lock.yaml",
)
use_repo(npm, "npm")

# --- Container base image ---------------------------------------------------
# The Python interpreter and Node.js come from the Bazel toolchains above, so
# the base only needs glibc and bash (for the launcher scripts).
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "debian_slim",
    digest = "sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f",  # trixie-slim
    image = "docker.io/library/debian",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "debian_slim", "debian_slim_linux_amd64", "debian_slim_linux_arm64_v8")
